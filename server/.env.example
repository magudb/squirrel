# Squirrel link service — environment.
#
# Copy to .env.local for `vercel dev`; in production set these under
# Vercel > Settings > Environment Variables. Every accessor in api/_lib/env.ts
# throws on a missing value, so a typo here surfaces as a 500 on the first
# request rather than as an open or silently misbehaving API.

# --- Auth -------------------------------------------------------------------

# Bearer token the extension sends. Mint 256 bits of entropy with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SQUIRREL_TOKEN=

# Optional second accepted token. Set this to the outgoing value during a
# rotation so old and new extension installs both work, then clear it.
SQUIRREL_TOKEN_PREVIOUS=

# Secret for /api/cron/flush only — the extension token is rejected there and
# this one is rejected everywhere else. Mint it the same way as SQUIRREL_TOKEN.
#
# YOU MUST CREATE THIS YOURSELF, in Vercel > Settings > Environment Variables
# (Production), BEFORE the first deploy. Vercel does not generate it: it attaches
# `Authorization: Bearer $CRON_SECRET` to cron invocations only if the variable
# exists. Leave it unset and every cron run arrives with no Authorization header,
# gets a 401, and — because Vercel never retries a cron and does not surface cron
# failures — the daily safety net is dead while the deployment looks healthy.
#
# Verify it after the first deploy rather than assuming:
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#        -H "user-agent: vercel-cron/1.0" \
#        https://<your-deployment>/api/cron/flush
# then check that GET /api/status reports a fresh `lastFlush`.
CRON_SECRET=

# --- GitHub (the blog repo every write lands in) ----------------------------

# Repository owner (user or org).
GITHUB_OWNER=magudb

# Repository name.
GITHUB_REPO=magudb.github.io

# Branch commits are made against. Defaults to master when unset.
GITHUB_BRANCH=master

# Fine-grained PAT scoped to the single blog repo above, with exactly one
# permission: Contents: Read and write. Do NOT grant Workflows — that is the
# difference between "can edit posts" and "can run arbitrary CI with the repo's
# secrets". Fine-grained PATs default to a 30-day expiry: pick a longer one at
# creation, and watch /api/status, because an expired PAT turns every flush into
# a silent upstream failure while the buffer keeps growing.
GITHUB_TOKEN=

# --- Redis (Upstash, over HTTP) ---------------------------------------------

# Either pair is accepted, checked in this order. The Vercel Marketplace
# Upstash integration injects the KV_* names; a hand-provisioned database gives
# the UPSTASH_* names. Do not apply a Custom Prefix when connecting the resource
# — it renames these and nothing finds them.
# REDIS_URL and KV_URL are deliberately ignored: those are TCP redis:// URLs
# and the HTTP client cannot use them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- CORS -------------------------------------------------------------------

# Comma-separated origins echoed back instead of the "*" default, e.g.
# chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef. Only exercised before
# the user grants the extension a host permission for this deployment — after
# that Chrome bypasses CORS entirely and these headers are never checked.
ALLOWED_ORIGINS=

# --- Flush policy -----------------------------------------------------------

# Buffered links after which the API reports flushSuggested. Default 5.
FLUSH_LINK_THRESHOLD=5

# Age of the oldest buffered link, in minutes, after which the API reports
# flushSuggested. Default 720 (12h).
FLUSH_MAX_AGE_MINUTES=720

# --- Cron schedule (lives in vercel.json, which cannot hold comments) --------
#
# vercel.json ships { "path": "/api/cron/flush", "schedule": "0 6 * * *" }.
# Hobby caps cron at once per day and FAILS THE DEPLOYMENT on anything more
# frequent — "*/15 * * * *" does not just skip runs, it breaks the build. On
# Pro, change that one field to "*/15 * * * *".
#
# This matters less than it looks: flush timing is driven by a chrome.alarms
# timer in the extension, which knows when the user is actually saving links.
# The cron is the safety net for a buffer left sitting while the browser is
# closed.
